# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Settings -> API no painel do Supabase). Nunca faça commit do arquivo .env.local.

# URL do projeto Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Service role key (secreta!) - usada apenas no servidor (API routes), nunca exposta ao navegador
SUPABASE_SERVICE_ROLE_KEY=
